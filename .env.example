# ChatGPT/Codex supply structured lessons using their own model. No provider key needed.
# Topic-only event-loop and photosynthesis demos also work in this default mode.
LESSON_PLANNER=host
# Optional deterministic demo-only mode: LESSON_PLANNER=fixture
# Optional standalone server-side generation through an OpenAI-compatible provider:
# LESSON_PLANNER=llm
# LLM_API_KEY=
# LLM_MODEL=your-provider-model
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_MS=60000
# PORT=3001
