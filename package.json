{
  "name": "visual-learning-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts --http",
    "build": "vite build && vite build --config vite.host.config.ts && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js --stdio",
    "serve": "node dist/server/index.js --http",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "build:worker": "npm run build && node --import tsx scripts/prepare-worker.ts",
    "worker:types": "wrangler types",
    "worker:typecheck": "tsc -p tsconfig.worker.json",
    "worker:smoke": "node --import tsx scripts/smoke-worker.ts",
    "worker:dev": "npm run build:worker && wrangler dev",
    "worker:check": "npm run build:worker && wrangler deploy --dry-run",
    "worker:deploy": "npm run build:worker && wrangler deploy"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "wrangler": "^4.149.0"
  }
}
